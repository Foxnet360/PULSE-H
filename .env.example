# PULSO-H Environment Variables
# Copy this file to .env and fill in your values

# Application
VITE_APP_VERSION=1.0.0

# Public contact data displayed in the footer
VITE_CONTACT_PHONE=+57 300 123 4567
VITE_CONTACT_EMAIL=hola@acrux.life

# Sentry Error Tracking (optional)
# Get your DSN from https://sentry.io
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# API Base URL
# For local development, use the PHP dev server
# For production, use the Hostinger domain
VITE_API_BASE_URL=http://localhost:8000/api

# Google Analytics (already configured in index.html)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Admin authentication (server-side only, NOT exposed to the frontend)
PULSO_ADMIN_PASSWORD=your_secure_admin_password

# Database configuration
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ACRUX unified nurturing database configuration
# Used to write leads into acruxdb.nurturing_sequences
ACRUX_DB_HOST=localhost
ACRUX_DB_NAME=acruxdb
ACRUX_DB_USER=your_acruxdb_user
ACRUX_DB_PASS=your_acruxdb_password

# SMTP Email Configuration
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="PULSO-H <your_smtp_user>"

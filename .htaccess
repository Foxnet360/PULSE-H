# Deny web access to sensitive files
<FilesMatch "^\.env|^\.git|^\.atl|^\.agents">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing
Options -Indexes
